// Fenix Cars driver registration schema
// Connection URLs live in prisma.config.ts (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  PENDING
  PAID
}

enum TimeEntryStatus {
  OPEN
  CLOSED
}

model Driver {
  id              String       @id @default(cuid())
  fullName        String
  employeeId      String       @unique
  contactNumber   String
  jobRole         String
  status          DriverStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedByEmail String?
  email           String?
  address         String?
  userId          String?      @unique
  // Driver-specific details captured at public registration. Nullable because
  // staff/manager records created from /admin/employees never collect them.
  nationality       String?
  yearsOfExperience Int?
  licenceNumber     String?
  licenceType       String?
  payrolls        Payroll[]
  timeEntries     TimeEntry[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([jobRole])
}

model Payroll {
  id          String        @id @default(cuid())
  driverId    String
  driver      Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  periodMonth Int
  periodYear  Int
  basicSalary Float
  allowances  Float         @default(0)
  deductions  Float         @default(0)
  netSalary   Float
  status      PayrollStatus @default(PENDING)
  paidDate    DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([driverId, periodMonth, periodYear])
  @@index([periodYear, periodMonth])
  @@index([status])
}

model TimeEntry {
  id        String          @id @default(cuid())
  driverId  String
  driver    Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  clockIn   DateTime
  clockOut  DateTime?
  status    TimeEntryStatus @default(OPEN)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([driverId, clockIn])
  @@index([status])
  @@index([clockIn])
}
